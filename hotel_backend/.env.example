# Email (optional for local VNPay testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM=Hotel Management <your-email@example.com>

# Frontend/backend URLs for local development
APP_BASE_URL=http://localhost:4173
API_PUBLIC_URL=http://localhost:5000

# VNPay Sandbox credentials from your merchant registration email
# Set to true to resume VNPay; leave false while testing booking without the gateway.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=replace-with-your-8-character-code
VNPAY_HASH_SECRET=replace-with-your-vnpay-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
# Configure this public HTTPS URL in the VNPay merchant portal for IPN:
# https://your-public-backend-domain/api/payments/vnpay/ipn

JWT_SECRET=replace-with-a-random-local-secret
